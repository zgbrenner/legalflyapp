{
  "name": "legalfly-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/export-legalfly-graph.mjs",
    "prebuild": "node scripts/export-legalfly-graph.mjs",
    "test:legalfly": "node scripts/export-legalfly-graph.mjs && node --test tests/legalfly/*.test.mjs",
    "test:dream": "node scripts/export-dream-graph.mjs && node --test tests/dream/*.test.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "2.15.4",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "jsdom": "25.0.1",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
