{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Vercel is a redirect shell; nothing to install.'",
  "buildCommand": "node scripts/build-vercel-redirect-shell.mjs",
  "outputDirectory": ".vercel-redirect",
  "redirects": [
    {
      "source": "/",
      "destination": "https://legalfly-web.onrender.com/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://legalfly-web.onrender.com/:path*",
      "permanent": false
    }
  ]
}
