# LegalFly configuration
LEGALFLY_DEMO_MODE=false
LEGALFLY_API_HOST=0.0.0.0
LEGALFLY_API_PORT=8000
LEGALFLY_CORS_ORIGINS=http://localhost:3000
LEGALFLY_MAX_TEXT_CHARS=4000
LEGALFLY_LOG_RAW_TEXT=false
LEGALFLY_SEED=42
LEGALFLY_DATA_DIR=data
LEGALFLY_MODELS_DIR=models
LEGALFLY_RESULTS_DIR=results
LEGALFLY_ENCODER=minilm

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# On Vercel, set this to your Render/Fly API URL, e.g. https://legalfly-api.onrender.com
NEXT_PUBLIC_DEMO_MODE=false

# Public API tip: LEGALFLY_CORS_ORIGINS=* (or your Vercel domain)
# Slim public image uses LEGALFLY_ENCODER=hashing (see Dockerfile.api / DEPLOY.md)
