# The Legal Fly: local development defaults.
# Production images disable runtime auto-training.
LEGALFLY_API_HOST=0.0.0.0
LEGALFLY_API_PORT=8000
LEGALFLY_CORS_ORIGINS=http://localhost:3000
LEGALFLY_MAX_TEXT_CHARS=4000
LEGALFLY_LOG_RAW_TEXT=false
LEGALFLY_ALLOW_AUTO_TRAIN=true
LEGALFLY_SEED=42
LEGALFLY_DATA_DIR=data
LEGALFLY_MODELS_DIR=models
LEGALFLY_RESULTS_DIR=results
LEGALFLY_ENCODER=hashing

# Put this in apps/web/.env.local, or the frontend host's environment and rebuild.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Graph provenance comes from the actual dataset, not a frontend flag.
# Configure exact production CORS origins. Do not default to a wildcard.
