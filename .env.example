# LegalFly configuration
LEGALFLY_DEMO_MODE=true
LEGALFLY_API_HOST=0.0.0.0
LEGALFLY_API_PORT=8000
LEGALFLY_CORS_ORIGINS=http://localhost:3000
LEGALFLY_MAX_TEXT_CHARS=4000
LEGALFLY_LOG_RAW_TEXT=false
LEGALFLY_SEED=42

# Paths (relative to repo root)
LEGALFLY_DATA_DIR=data
LEGALFLY_MODELS_DIR=models
LEGALFLY_RESULTS_DIR=results

# Encoder: hashing (offline demo) | sentence-transformers (research)
LEGALFLY_ENCODER=hashing
# LEGALFLY_ST_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true