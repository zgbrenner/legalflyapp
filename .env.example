# Optional settings for the retained Python research/API tooling.
# The public Legal Dreaming web app does not require these variables.
LEGALFLY_API_HOST=0.0.0.0
LEGALFLY_API_PORT=8000
LEGALFLY_CORS_ORIGINS=http://localhost:3000
LEGALFLY_MAX_TEXT_CHARS=4000
LEGALFLY_LOG_RAW_TEXT=false
LEGALFLY_ALLOW_AUTO_TRAIN=true
LEGALFLY_SEED=42
LEGALFLY_DATA_DIR=data
LEGALFLY_MODELS_DIR=models
LEGALFLY_RESULTS_DIR=results
LEGALFLY_ENCODER=hashing

# Legal Dreaming is browser-local. No NEXT_PUBLIC_API_URL or API key is required.
