# syntax=docker/dockerfile:1
#
# Base images are pinned by content digest, not by mutable tag. The digests are
# the multi-architecture index digests published on Docker Hub for
# python:3.12-slim (CPython 3.12.14, Debian trixie, glibc 2.41) and
# node:20-alpine as of 2026-09-15. Render builds on linux/amd64, which every
# pinned index and every hash-locked wheel below covers.
#
# Both Python conversion stages install only from hash-locked requirement files
# generated by tools/requirements/lock.sh, so a substituted wheel or a moved
# transitive release fails the build instead of silently changing the graph or
# the parity-verified MiniMind bundle.

# Build the official, pinned MaleCNS v1.0 browser artifacts without retaining
# the 1 GB publisher source files in the runtime image.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS connectome
WORKDIR /repo
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
COPY tools/requirements/malecns.txt ./tools/requirements/malecns.txt
RUN python -m pip install \
      --require-hashes \
      --only-binary=:all: \
      --requirement tools/requirements/malecns.txt
COPY tools/prepare_malecns.py ./tools/prepare_malecns.py
RUN python tools/prepare_malecns.py --download --convert --export-browser --shuffled

# Export the pinned, parity-selected browser MiniMind bundle in a disposable
# stage. The runtime image receives only the five verified public artifacts.
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS minimind
WORKDIR /repo
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUTF8=1 \
    PYTHONPATH=/repo \
    CUDA_VISIBLE_DEVICES=""
COPY tools/requirements/minimind-browser.txt ./tools/requirements/minimind-browser.txt
RUN python -m pip install \
      --require-hashes \
      --only-binary=:all: \
      --requirement tools/requirements/minimind-browser.txt
COPY tools/prepare_minimind.py tools/prepare_minimind_browser.py tools/export_minimind_readouts.py ./tools/
COPY apps/__init__.py ./apps/__init__.py
COPY apps/minimind_adapter/__init__.py apps/minimind_adapter/service.py ./apps/minimind_adapter/
COPY apps/web/public/legalfly/cases.json ./apps/web/public/legalfly/cases.json
RUN python tools/prepare_minimind_browser.py \
      --download \
      --convert \
      --quantization q8 \
      --source /repo/models/minimind-3 \
      --output /repo/browser-minimind \
    && python tools/prepare_minimind_browser.py \
      --check \
      --output /repo/browser-minimind \
    && python tools/export_minimind_readouts.py \
      --model-path /repo/models/minimind-3 \
      --output /repo/browser-minimind \
      --compare

FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS dependencies
WORKDIR /repo/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder
WORKDIR /repo/apps/web
ENV LEGALFLY_REQUIRE_FULL=1 \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=dependencies /repo/apps/web/node_modules ./node_modules
# Dockerfile.web.dockerignore keeps apps/web/public/minimind (including the
# tracked .gitkeep placeholder and any local bundle copy) out of the build
# context, so the directory below is created only from the verified stage.
COPY apps/web ./
COPY --from=connectome /repo/data/processed/malecns/v1.0/browser /repo/data/processed/malecns/v1.0/browser
COPY --from=minimind /repo/browser-minimind ./public/minimind
# --exact fails the build if the runtime MiniMind directory holds anything
# other than manifest.json and the five content-addressed artifacts.
RUN node scripts/verify-minimind-assets.mjs --exact && npm run build

FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS runner
WORKDIR /app
ENV HOSTNAME=0.0.0.0 \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000
COPY --from=builder --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /repo/apps/web/.next/static ./.next/static
COPY --from=builder --chown=node:node /repo/apps/web/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
