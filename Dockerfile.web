# Build the official, pinned MaleCNS v1.0 browser artifacts without retaining
# the 1 GB publisher source files in the runtime image.
FROM python:3.12-slim AS connectome
WORKDIR /repo
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1
COPY tools/prepare_malecns.py ./tools/prepare_malecns.py
RUN python -m pip install \
      numpy==2.1.3 \
      pandas==2.2.3 \
      pyarrow==17.0.0 \
    && python tools/prepare_malecns.py --download --convert --export-browser --shuffled

FROM node:20-alpine AS dependencies
WORKDIR /repo/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /repo/apps/web
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=dependencies /repo/apps/web/node_modules ./node_modules
COPY apps/web ./
COPY --from=connectome /repo/data/processed/malecns/v1.0/browser /repo/data/processed/malecns/v1.0/browser
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV HOSTNAME=0.0.0.0 \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000
COPY --from=builder --chown=node:node /repo/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /repo/apps/web/.next/static ./.next/static
COPY --from=builder --chown=node:node /repo/apps/web/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
